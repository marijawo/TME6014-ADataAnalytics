{
  "name": "Churn Analytics Executive Theme",
  "dataColors": [
    "#2563EB",
    "#EF4444",
    "#DC2626",
    "#10B981",
    "#06B6D4",
    "#8B5CF6"
  ],
  "background": "#F5F7FB",
  "foreground": "#111827",
  "tableAccent": "#2563EB",

  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "color": "#111827"
          }
        ],
        "background": [
          {
            "color": "#FFFFFF",
            "transparency": 0
          }
        ],
        "legend": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "labelColor": "#374151"
          }
        ]
      }
    },

    "card": {
      "*": {
        "calloutValue": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 34,
            "color": "#111827"
          }
        ],
        "categoryLabel": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "color": "#6B7280"
          }
        ]
      }
    },

    "lineChart": {
      "*": {
        "xAxis": [
          {
            "labelColor": "#6B7280"
          }
        ],
        "yAxis": [
          {
            "labelColor": "#6B7280",
            "gridlineColor": "#E5E7EB"
          }
        ]
      }
    },

    "columnChart": {
      "*": {
        "xAxis": [
          {
            "labelColor": "#6B7280"
          }
        ],
        "yAxis": [
          {
            "labelColor": "#6B7280",
            "gridlineColor": "#E5E7EB"
          }
        ]
      }
    }
  }
}
